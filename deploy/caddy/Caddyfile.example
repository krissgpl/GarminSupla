{
    admin off
    auto_https disable_redirects
}

# Internal HTTP endpoint.
# Do not publish port 8080 to the Internet.
:8080 {
    handle /api/v1/watch/* {
        reverse_proxy garminsupla-watch:8008
    }

    handle {
        respond "Not Found" 404
    }
}

# Domain is supplied through GARMIN_SUPLA_WATCH_DOMAIN.
# Certificate and private key must be mounted read-only.
https://{$GARMIN_SUPLA_WATCH_DOMAIN}:8008 {
    tls /run/garminsupla-watch-certs/fullchain.pem /run/garminsupla-watch-certs/private.key

    handle /api/v1/watch/* {
        reverse_proxy garminsupla-watch:8008
    }

    handle {
        respond "Not Found" 404
    }
}
